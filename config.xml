<?xml version='1.0' encoding='utf-8'?>
<widget id="com.vividmindstudios.witchtrials" 
        version="1.0.0" 
        android-versionCode="2" 
        xmlns="http://www.w3.org/ns/widgets" 
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>The Witch's 500 Trials</name>
    <description>
        Think Like a King. Outsmart the Witch. Rescue the Queen. Solve 500 mystical riddles across 20 enchanted realms.
    </description>
    <author email="vividmindstudios@gmail.com" href="https://subha28suresh-svg.github.io/the-witchs-500-trials/privacy-policy.html">
        Vividmind Studios
    </author>

    <content src="index.html" />

    <!-- External Network & Intent Whitelist -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Android Platform Configuration -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />

        <preference name="Orientation" value="portrait" />
        <preference name="Fullscreen" value="true" />
        <preference name="BackgroundColor" value="#05070c" />
        <preference name="KeepRunning" value="true" />
        <preference name="SplashScreenDelay" value="0" />
        <preference name="AutoHideSplashScreen" value="true" />
        <preference name="FadeSplashScreen" value="false" />
        <preference name="ShowSplashScreenSpinner" value="false" />
        <preference name="AndroidWindowSplashScreenBackground" value="#05070c" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="assets/icons/transparent_icon.png" />

        <!-- Launcher Icons -->
        <icon src="assets/icons/icon-192.png" density="mdpi" />
        <icon src="assets/icons/icon-512.png" density="xxxhdpi" />

        <!-- AdMob Android Manifest Meta-Data -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <meta-data
                android:name="com.google.android.gms.ads.APPLICATION_ID"
                android:value="ca-app-pub-3940256099942544~3347511713" />
        </config-file>
    </platform>

        <!-- Google AdMob Plugin -->
        <plugin name="cordova-plugin-admob-plus" spec="^1.28.0">
            <variable name="APP_ID_ANDROID" value="ca-app-pub-3940256099942544~3347511713" />
        </plugin>

        <preference name="DisallowOverscroll" value="true" />
</widget>